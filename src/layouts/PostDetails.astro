---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import type { SortedBlogPost } from "@/utils/getSortedPosts";
import dayjs from "@/utils/dayjs";
import { getPostPath } from "@/utils/getPostPath";
import { getReadingMinutes } from "@/utils/readingTime";
import { getTocHeadings } from "@/utils/toc";
import { resolveOgImage } from "@/utils/ogImage";
import { slugifyStr } from "@/utils/slugifyCore";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import "katex/dist/katex.min.css";
import "@/styles/doc-layout.css";
import "@/styles/post.css";

type Props = {
  post: SortedBlogPost;
  posts: SortedBlogPost[];
};

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content, headings, remarkPluginFrontmatter } = await render(post);
const tocHeadings = getTocHeadings(
  headings,
  remarkPluginFrontmatter.headingText
);
const showToc = tocHeadings.length >= 3;

const published = dayjs.utc(pubDatetime);
const modified = modDatetime ? dayjs.utc(modDatetime) : null;
const showModified = modified !== null && !modified.isSame(published, "day");
const readingMinutes = getReadingMinutes(post.body ?? "");

const ogImage = resolveOgImage(initOgImage, Astro.url.origin);

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  scrollSmooth: true,
};

const allPosts = posts.map(postEntry => ({
  id: postEntry.id,
  title: postEntry.data.title,
  href: getPostPath(postEntry),
}));

const currentPostIndex = allPosts.findIndex(entry => entry.id === post.id);

const prevPost = currentPostIndex > 0 ? allPosts[currentPostIndex - 1] : null;
const nextPost =
  currentPostIndex >= 0 && currentPostIndex < allPosts.length - 1
    ? allPosts[currentPostIndex + 1]
    : null;
---

<Layout {...layoutProps}>
  <Header />
  <BackButton label="All Posts" />
  <main
    id="main-content"
    class:list={[
      "post-detail app-layout pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
  >
    <header class="post-hero">
      {
        tags.length > 0 && (
          <ul class="post-hero__tags" aria-label="Tags">
            {tags.map(tag => (
              <li>
                <a href={`/tags/${slugifyStr(tag)}/`}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
      <h1
        transition:name={slugifyStr(title.replaceAll(".", "-"))}
        class="post-hero__title"
      >
        {title}
      </h1>
      <p class="post-hero__description">{description}</p>
      <p class="post-hero__meta">
        <time datetime={published.toISOString()}>
          {published.format("D MMM YYYY")}
        </time>
        {
          showModified && (
            <span>
              Updated{" "}
              <time datetime={modified.toISOString()}>
                {modified.format("D MMM YYYY")}
              </time>
            </span>
          )
        }
        <span>{readingMinutes} min read</span>
      </p>
    </header>

    <div class="doc-body">
      <aside class="doc-aside doc-aside--wide-only" aria-label="Post details">
        <div class="doc-panel card-border">
          <dl class="doc-facts">
            <div>
              <dt class="doc-panel__label">Published</dt>
              <dd class="doc-facts__value font-code">
                <time datetime={published.toISOString()}>
                  {published.format("D MMM YYYY")}
                </time>
              </dd>
            </div>
            {
              showModified && (
                <div>
                  <dt class="doc-panel__label">Updated</dt>
                  <dd class="doc-facts__value font-code">
                    <time datetime={modified.toISOString()}>
                      {modified.format("D MMM YYYY")}
                    </time>
                  </dd>
                </div>
              )
            }
            <div>
              <dt class="doc-panel__label">Read time</dt>
              <dd class="doc-facts__value font-code">{readingMinutes} min</dd>
            </div>
            {
              tags.length > 0 && (
                <div class="doc-facts__wide">
                  <dt class="doc-panel__label">Tags</dt>
                  <dd class="doc-facts__value doc-facts__chips">
                    {tags.map(tag => (
                      <a
                        class="doc-facts__chip"
                        href={`/tags/${slugifyStr(tag)}/`}
                      >
                        {tag}
                      </a>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>

          {
            showToc && (
              <nav class="doc-toc" aria-label="On this page">
                <p class="doc-panel__label">On this page</p>
                <ol>
                  {tocHeadings.map(heading => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class:list={[
                          "toc-link ink-link",
                          heading.depth === 3 && "level-3",
                          heading.depth === 4 && "level-4",
                        ]}
                        data-toc-link
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )
          }
        </div>
      </aside>

      <div class="doc-main">
        {
          showToc && (
            <details class="post-toc-inline">
              <summary>On this page</summary>
              <nav aria-label="On this page">
                <ol>
                  {tocHeadings.map(heading => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class:list={[
                          "toc-link ink-link",
                          heading.depth === 3 && "level-3",
                          heading.depth === 4 && "level-4",
                        ]}
                        data-toc-link
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </details>
          )
        }
        <article id="article" class="app-prose">
          <Content />
        </article>

        <hr class="divider my-8" />

        <BackToTopButton />

        <ShareLinks title={title} />

        <hr class="divider my-6" />

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            prevPost && (
              <a
                href={prevPost.href}
                class="flex w-full gap-1 hover:opacity-75"
              >
                <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
                <div>
                  <span class="notebook-kicker">Previous Post</span>
                  <div class="ink-link content-title mt-1 text-sm">
                    {prevPost.title}
                  </div>
                </div>
              </a>
            )
          }
          {
            nextPost && (
              <a
                href={nextPost.href}
                class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
              >
                <div>
                  <span class="notebook-kicker">Next Post</span>
                  <div class="ink-link content-title mt-1 text-sm">
                    {nextPost.title}
                  </div>
                </div>
                <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { setupPostDetailsPage } from "@/scripts/postDetails.js";

  type PostDetailsWindow = Window & {
    __postDetailsLifecycleCleanup?: () => void;
  };

  (window as PostDetailsWindow).__postDetailsLifecycleCleanup?.();
  document.addEventListener("astro:page-load", setupPostDetailsPage);
  document.addEventListener("astro:after-swap", setupPostDetailsPage);
  (window as PostDetailsWindow).__postDetailsLifecycleCleanup = () => {
    document.removeEventListener("astro:page-load", setupPostDetailsPage);
    document.removeEventListener("astro:after-swap", setupPostDetailsPage);
  };
  setupPostDetailsPage();
</script>
