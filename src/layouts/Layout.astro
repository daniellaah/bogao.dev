---
// First, so component stylesheets imported below override its primitives.
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import {
  PUBLIC_BAIDU_SITE_VERIFICATION,
  PUBLIC_GOOGLE_SITE_VERIFICATION,
} from "astro:env/client";
import CommandPalette from "@/components/CommandPalette.astro";
import { SITE } from "@/config";
import { getOgLocale } from "@/utils/contentLang";

type Props = {
  title?: string;
  author?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  lang?: string;
  // schema.org JSON-LD for the page; defaults to a WebPage.
  structuredData?: Record<string, unknown>;
};

const {
  title = SITE.title,
  author = SITE.author,
  description = SITE.desc,
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  lang = SITE.lang,
  structuredData = {
    "@type": "WebPage",
    name: title,
    description,
    url: `${canonicalURL}`,
    inLanguage: lang,
  },
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.url);
const isArticle = Boolean(pubDatetime);
const ogType = isArticle ? "article" : "website";
const socialImageAlt = `${title} | ${SITE.title}`;

// Escape "<" so no string in the data can close the <script> element.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  ...structuredData,
}).replaceAll("<", "\\u003c");
---

<!doctype html>
<html dir={SITE.dir} lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/Handlee-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/images/site/avatar.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={getOgLocale(lang)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }
    {isArticle && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={socialImageAlt} />

    <!-- Google JSON-LD Structured data -->
    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("/rss.xml", Astro.url)}
    />

    <meta name="theme-color" content="#f6f1e7" />
    <script is:inline>
      (() => {
        const storedTheme = (() => {
          try {
            return localStorage.getItem("theme");
          } catch {
            return null;
          }
        })();
        const theme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";

        document.documentElement.dataset.theme = theme;
        document
          .querySelector("meta[name='theme-color']")
          ?.setAttribute("content", theme === "dark" ? "#12151d" : "#f6f1e7");
      })();
    </script>

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    {
      PUBLIC_BAIDU_SITE_VERIFICATION && (
        <meta
          name="baidu-site-verification"
          content={PUBLIC_BAIDU_SITE_VERIFICATION}
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    <slot />
    <CommandPalette />
    <script>
      import "@/scripts/theme";
      import { onEveryPage } from "@/scripts/lifecycle";
      import { setupBackNavigation } from "@/scripts/backNavigation";

      onEveryPage(setupBackNavigation);
    </script>
  </body>
</html>
