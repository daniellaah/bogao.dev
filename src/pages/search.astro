---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
import "@/styles/search.css";
import {
  SEARCH_KINDS,
  formatSearchEmptyPrompt,
  formatSearchInputPlaceholder,
} from "@/utils/search";

const searchAllScope = SEARCH_KINDS[0].scope;
const searchInputPlaceholder = formatSearchInputPlaceholder(searchAllScope);
---

<Layout title={`Search | ${SITE.title}`}>
  <Main pageTitle="Search" pageDesc={`${searchInputPlaceholder}.`}>
    <section class="space-y-5">
      <div class="panel card-border search-box relative">
        <label class="sr-only" for="search-input">Search</label>
        <input
          id="search-input"
          type="search"
          placeholder={searchInputPlaceholder}
          class="search-input w-full border-0 bg-transparent px-5 py-4 pe-24 text-lg outline-hidden placeholder:text-graphite"
          autocomplete="off"
        />
        <button
          id="search-clear"
          type="button"
          class="search-clear ink-link absolute top-1/2 right-4 -translate-y-1/2 font-code text-xs text-graphite hover:text-foreground"
        >
          Clear
        </button>
      </div>

      <div
        id="search-kind-filters"
        class="flex flex-wrap gap-2"
        aria-label="Filter search results by type"
      >
        {
          SEARCH_KINDS.map((kind, index) => (
            <button
              type="button"
              data-search-kind={kind.filter}
              class="chip inline-flex items-center px-3 py-1 text-sm font-medium text-graphite transition hover:bg-muted/70 hover:text-foreground"
              aria-pressed={index === 0 ? "true" : "false"}
              data-active={index === 0 ? true : undefined}
            >
              {kind.label}
            </button>
          ))
        }
      </div>

      <p id="search-status" class="font-code text-xs text-graphite">
        {formatSearchEmptyPrompt(searchAllScope)}
      </p>

      <ul id="search-results"></ul>
    </section>
  </Main>
</Layout>

<script>
  import { onEveryPage } from "@/scripts/lifecycle";
  import { setupSearchPage } from "@/scripts/searchPage";

  onEveryPage(setupSearchPage);
</script>
