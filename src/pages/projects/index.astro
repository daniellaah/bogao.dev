---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import OpenSourceCard from "@/components/OpenSourceCard.astro";
import { OPEN_SOURCE } from "@/data/profile";
import getSortedProjects from "@/utils/getSortedProjects";
import { SITE } from "@/config";

const projects = getSortedProjects(await getCollection("projects"));
---

<Layout
  title={`Projects | ${SITE.title}`}
  description="Projects and open-source contributions by Bo Gao: agentic RAG, production recommender retrieval, and LLM tooling."
>
  <Header />
  <Main pageTitle="Projects">
    {
      projects.length > 0 ? (
        <div class="work-grid">
          {projects.map(project => (
            <ProjectCard {...project} />
          ))}
        </div>
      ) : (
        <section class="sketch-box sketch-border p-8">
          <h2 class="text-2xl font-semibold">No projects published yet.</h2>
          <p class="mt-3 max-w-2xl leading-8 opacity-80">
            Add Markdown files under <code>src/content/projects</code> to
            publish your project cards here.
          </p>
        </section>
      )
    }

    <section
      class="sketch-edge-top mt-12 pt-8"
      aria-labelledby="open-source-heading"
    >
      <h2 id="open-source-heading" class="text-2xl font-semibold">
        Open Source Contributions
      </h2>
      <div class="work-grid work-grid--alt mt-6">
        {OPEN_SOURCE.map(entry => <OpenSourceCard {...entry} />)}
      </div>
    </section>
  </Main>
  <Footer />
</Layout>
