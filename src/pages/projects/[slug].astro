---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BackButton from "@/components/BackButton.astro";
import TocList from "@/components/TocList.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import ProjectStatusBadge from "@/components/ProjectStatusBadge.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import { getProjects, getProjectSlug } from "@/utils/projects";
import { resolveOgImage } from "@/utils/ogImage";
import { getTocHeadings } from "@/utils/toc";
import { SITE } from "@/config";
import "@/styles/doc-layout.css";
import "@/styles/project.css";

export const getStaticPaths = (async () => {
  const projects = await getProjects();

  return projects.map(project => ({
    params: { slug: getProjectSlug(project.id) },
    props: { project, projects },
  }));
}) satisfies GetStaticPaths;

const { project, projects } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(project);

const {
  title,
  kicker,
  description,
  status,
  stack,
  year,
  demoUrl,
  repoUrl,
  canonicalURL,
} = project.data;
const ogImage = resolveOgImage(project.data.ogImage, Astro.url.origin);

const { accent } = project;

const tocHeadings = getTocHeadings(
  headings,
  remarkPluginFrontmatter.headingText,
  { depths: [2, 3] }
);
const showToc = tocHeadings.length >= 3;

const relatedProjects = projects
  .filter(({ id }) => id !== project.id)
  .slice(0, 3);
---

<Layout
  title={`${title} | Projects | ${SITE.title}`}
  description={description}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
>
  <Header />
  <BackButton href="/projects/" label="Projects" />
  <main
    id="main-content"
    class:list={[
      "project-detail app-layout pb-12",
      `project-detail--${accent}`,
    ]}
  >
    <header class="project-hero">
      {kicker && <p class="project-hero__kicker">{kicker}</p>}
      <h1 class="project-hero__title">
        <span class:list={["marker-swipe", `marker-swipe--${accent}`]}>
          {title}
        </span>
      </h1>
      <p class="project-hero__description">{description}</p>
      {
        (repoUrl || demoUrl) && (
          <div class="project-hero__actions">
            {repoUrl && (
              <a
                class="hero-action hero-action--github"
                href={repoUrl}
                rel="noreferrer"
                target="_blank"
              >
                <IconGitHub aria-hidden="true" />
                View on GitHub
              </a>
            )}
            {demoUrl && (
              <a
                class="hero-action"
                href={demoUrl}
                rel="noreferrer"
                target="_blank"
              >
                Live demo
                <IconArrowRight aria-hidden="true" />
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="doc-body">
      <aside class="doc-aside" aria-label="Project details">
        <div class="doc-panel card-border">
          <dl class="doc-facts">
            <div>
              <dt class="doc-panel__label">Status</dt>
              <dd class="doc-facts__value">
                <ProjectStatusBadge status={status} />
              </dd>
            </div>
            {
              year && (
                <div>
                  <dt class="doc-panel__label">Year</dt>
                  <dd class="doc-facts__value font-code">{year}</dd>
                </div>
              )
            }
            {
              stack.length > 0 && (
                <div class="doc-facts__wide">
                  <dt class="doc-panel__label">Stack</dt>
                  <dd class="doc-facts__value doc-facts__chips">
                    {stack.map(item => (
                      <span>{item}</span>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>

          {
            showToc && (
              <nav class="doc-toc" aria-label="On this page">
                <p class="doc-panel__label">On this page</p>
                <TocList headings={tocHeadings} />
              </nav>
            )
          }
        </div>
      </aside>

      <article id="article" class="doc-main app-prose">
        <Content />
      </article>
    </div>

    {
      relatedProjects.length > 0 && (
        <section class="project-related">
          <h2 class="project-related__title">More projects</h2>
          <div class="work-grid">
            {relatedProjects.map(item => (
              <ProjectCard {...item} />
            ))}
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  import { onEveryPage } from "@/scripts/lifecycle";
  import { setupPostDetailsPage } from "@/scripts/postDetails";

  onEveryPage(setupPostDetailsPage);
</script>
