---
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import PostRow from "@/components/PostRow.astro";
import { slugifyStr } from "@/utils/slugifyCore";
import { getPosts } from "@/utils/posts";
import { collectTagStats } from "@/utils/tags";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPosts();
  const tags = collectTagStats(posts);

  return tags.flatMap(({ slug, tagName }) => {
    // getPosts already orders newest first.
    const taggedPosts = posts.filter(post =>
      post.data.tags.some(postTag => slugifyStr(postTag) === slug)
    );

    return paginate(taggedPosts, {
      params: { tag: slug },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <Header />
  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All posts with the tag "${tagName}".`}
  >
    <ul class="post-list mt-4">
      {page.data.map(post => <PostRow post={post} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
