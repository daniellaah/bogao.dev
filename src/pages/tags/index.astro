---
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getPosts } from "@/utils/posts";
import { collectTagStats, getTagPath, type TagStat } from "@/utils/tags";
import { SITE } from "@/config";
import "@/styles/controls.css";
import "@/styles/tags.css";

const posts = await getPosts();

const tagCollator = new Intl.Collator(undefined, {
  sensitivity: "base",
  numeric: true,
});
const compareTags = (tagA: TagStat, tagB: TagStat) =>
  tagCollator.compare(tagA.tagName, tagB.tagName);
const compareTagsByPopularity = (tagA: TagStat, tagB: TagStat) =>
  tagB.count - tagA.count || compareTags(tagA, tagB);

const tags = collectTagStats(posts).sort(compareTags);
const tagsByPopularity = [...tags].sort(compareTagsByPopularity);
---

<Layout title={`Tags | ${SITE.title}`}>
  <Header />
  <Main pageTitle="Tags">
    <section class="space-y-8" data-tags-index data-tags-entering>
      <section>
        <div class="content-controls toggle-panel-rule tags-sort-panel mb-6">
          <div class="content-status">
            <p
              class="content-status__message"
              data-tags-status
              aria-live="polite"
            >
              Showing all {tags.length} topics, sorted by popularity.
            </p>
          </div>

          <div
            class="grid gap-2 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:items-center"
          >
            <span class="notebook-kicker">Sort By</span>
            <div
              class="ink-toggle tags-sort-toggle flex flex-wrap gap-2"
              aria-label="Sort all tags"
              data-tags-sort-toggle
            >
              <button
                type="button"
                class="ink-toggle-button tags-sort-button chip inline-flex min-h-11 items-center px-3 py-1 text-sm font-medium"
                data-tag-sort="popular"
                data-active
                aria-pressed="true"
              >
                Pop
              </button>
              <button
                type="button"
                class="ink-toggle-button tags-sort-button chip inline-flex min-h-11 items-center px-3 py-1 text-sm font-medium"
                data-tag-sort="az"
                aria-pressed="false"
              >
                A-Z
              </button>
            </div>
          </div>
        </div>

        <ul class="tags-card-grid" data-tags-card-grid>
          {
            tagsByPopularity.map((tag, index) => (
              <li
                data-tag-card
                data-tag-name={tag.tagName}
                data-count={tag.count}
                style={`--tag-enter-delay: ${Math.min(index * 16, 220)}ms;`}
              >
                <a
                  href={getTagPath(tag.slug)}
                  class="tags-tag-card card-border hover-underline-trigger"
                >
                  <span class="tags-tag-card__name hover-underline min-w-0 text-lg">
                    #<span transition:name={tag.slug}>{tag.tagName}</span>
                  </span>
                  <span class="tag-count-badge">
                    {tag.count}
                    <span class="sr-only">
                      {tag.count === 1 ? "post" : "posts"}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        {
          tags.length === 0 && (
            <div class="panel card-border mt-4 px-4 py-5 text-sm text-graphite">
              No tags yet.
            </div>
          )
        }
      </section>
    </section>
  </Main>
  <Footer />
</Layout>

<script>
  import { onEveryPage } from "@/scripts/lifecycle";
  import { setupTagsIndexPage } from "@/scripts/tagsIndex";

  onEveryPage(setupTagsIndexPage);
</script>
