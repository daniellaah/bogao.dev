---
import type { GetStaticPaths } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Pagination from "@/components/Pagination.astro";
import PostFilters from "@/components/PostFilters.astro";
import PostsList from "@/components/PostsList.astro";
import { getPosts } from "@/utils/posts";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getPosts(), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title={`Posts | ${SITE.title}`} footerNoMarginTop={page.lastPage > 1}>
  <Main pageTitle="Posts">
    <section class="filter-panel">
      <PostFilters posts={page.data} />
    </section>
    <PostsList posts={page.data} filterable />
  </Main>

  <Pagination {page} />
</Layout>
