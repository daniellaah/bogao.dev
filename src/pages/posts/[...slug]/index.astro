---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import TocList from "@/components/TocList.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import Comments from "@/components/Comments.astro";
import { formatDate, isSameDay } from "@/utils/date";
import {
  getPostOgImagePath,
  getPostPath,
  getPosts,
  type Post,
} from "@/utils/posts";
import { getReadingMinutes } from "@/utils/readingTime";
import { getTocHeadings } from "@/utils/toc";
import { resolveOgImage } from "@/utils/ogImage";
import { getContentLang } from "@/utils/contentLang";
import { slugifyStr } from "@/utils/slugifyCore";
import { getTagPath } from "@/utils/tags";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import { SITE } from "@/config";
import "katex/dist/katex.min.css";
import "@/styles/doc-layout.css";
import "@/styles/post.css";

type Props = {
  post: Post;
  posts: Post[];
};

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({
    params: { slug: getPostPath(post, false) },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content, headings, remarkPluginFrontmatter } = await render(post);
const tocHeadings = getTocHeadings(
  headings,
  remarkPluginFrontmatter.headingText
);
const showToc = tocHeadings.length >= 3;

const published = pubDatetime;
const modified =
  modDatetime && !isSameDay(modDatetime, published) ? modDatetime : null;
const readingMinutes = getReadingMinutes(post.body ?? "");

// A frontmatter ogImage wins over the generated card.
const ogImage =
  resolveOgImage(initOgImage, Astro.url.origin) ?? getPostOgImagePath(post);

const lang = getContentLang(post.data);
const url = canonicalURL ?? new URL(Astro.url.pathname, Astro.url).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage,
  lang,
  structuredData: {
    "@type": "BlogPosting",
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: lang,
    image: new URL(ogImage, Astro.url).href,
    datePublished: published.toISOString(),
    ...(modDatetime && { dateModified: modDatetime.toISOString() }),
    ...(tags.length > 0 && { keywords: tags.join(", ") }),
    author: { "@type": "Person", name: author, url: SITE.profile },
  },
};

// `posts` is newest first: the older post follows this one in the list.
const postIndex = posts.findIndex(entry => entry.id === post.id);
const toLink = (entry: Post | undefined) =>
  entry && { title: entry.data.title, href: getPostPath(entry) };
const olderPost = toLink(posts[postIndex + 1]);
const newerPost = postIndex > 0 ? toLink(posts[postIndex - 1]) : undefined;
---

<Layout {...layoutProps}>
  <BackButton href="/posts/" label="Posts" scope="posts" />
  <main
    id="main-content"
    class:list={[
      "post-detail app-layout pb-12",
      { "mt-8": !SITE.showBackButton },
    ]}
  >
    <header class="post-hero">
      {
        tags.length > 0 && (
          <ul class="post-hero__tags" aria-label="Tags">
            {tags.map(tag => (
              <li>
                <a href={getTagPath(slugifyStr(tag))}>{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
      <h1 class="post-hero__title">{title}</h1>
      <p class="post-hero__description">{description}</p>
      <p class="post-hero__meta">
        <time datetime={published.toISOString()}>
          {formatDate(published)}
        </time>
        {
          modified && (
            <span>
              Updated{" "}
              <time datetime={modified.toISOString()}>
                {formatDate(modified)}
              </time>
            </span>
          )
        }
        <span>{readingMinutes} min read</span>
      </p>
    </header>

    <div class="doc-body">
      <aside class="doc-aside doc-aside--wide-only" aria-label="Post details">
        <div class="doc-panel card-border">
          <dl class="doc-facts">
            <div>
              <dt class="doc-panel__label">Published</dt>
              <dd class="doc-facts__value font-code">
                <time datetime={published.toISOString()}>
                  {formatDate(published)}
                </time>
              </dd>
            </div>
            {
              modified && (
                <div>
                  <dt class="doc-panel__label">Updated</dt>
                  <dd class="doc-facts__value font-code">
                    <time datetime={modified.toISOString()}>
                      {formatDate(modified)}
                    </time>
                  </dd>
                </div>
              )
            }
            <div>
              <dt class="doc-panel__label">Read time</dt>
              <dd class="doc-facts__value font-code">{readingMinutes} min</dd>
            </div>
            {
              tags.length > 0 && (
                <div class="doc-facts__wide">
                  <dt class="doc-panel__label">Tags</dt>
                  <dd class="doc-facts__value doc-facts__chips">
                    {tags.map(tag => (
                      <a
                        class="doc-facts__chip"
                        href={getTagPath(slugifyStr(tag))}
                      >
                        {tag}
                      </a>
                    ))}
                  </dd>
                </div>
              )
            }
          </dl>

          {
            showToc && (
              <nav class="doc-toc" aria-label="On this page">
                <p class="doc-panel__label">On this page</p>
                <TocList headings={tocHeadings} />
              </nav>
            )
          }
        </div>
      </aside>

      <div class="doc-main">
        {
          showToc && (
            <details class="post-toc-inline">
              <summary>On this page</summary>
              <nav aria-label="On this page">
                <TocList headings={tocHeadings} />
              </nav>
            </details>
          )
        }
        <article id="article" class="app-prose">
          <Content />
        </article>

        <hr class="divider my-8" />

        <BackToTopButton />

        <ShareLinks title={title} />

        <hr class="divider my-6" />

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            olderPost && (
              <a
                href={olderPost.href}
                class="flex w-full gap-1 hover:opacity-75"
              >
                <IconChevronLeft class="inline-block flex-none rtl:rotate-180" />
                <div>
                  <span class="notebook-kicker">Older post</span>
                  <div class="ink-link mt-1 text-sm">{olderPost.title}</div>
                </div>
              </a>
            )
          }
          {
            newerPost && (
              <a
                href={newerPost.href}
                class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
              >
                <div>
                  <span class="notebook-kicker">Newer post</span>
                  <div class="ink-link mt-1 text-sm">{newerPost.title}</div>
                </div>
                <IconChevronRight class="inline-block flex-none rtl:rotate-180" />
              </a>
            )
          }
        </div>

        <Comments lang={lang} />
      </div>
    </div>
  </main>
</Layout>

<script>
  import { onEveryPage } from "@/scripts/lifecycle";
  import { setupPostDetailsPage } from "@/scripts/postDetails";

  onEveryPage(setupPostDetailsPage);
</script>
