---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconFileText from "@/assets/icons/IconFileText.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconLinkedIn from "@/assets/icons/IconLinkedIn.svg";
import { SITE } from "@/config";
import { getProjectPath } from "@/utils/getProjectPath";
import "@/styles/home.css";

const projects = await getCollection("projects", ({ data }) => !data.draft);

const selectedWorkSpecs = [
  {
    id: "bogaodev",
    tags: ["Vibe coding", "Personal site", "Writing"],
    artifact: "Personal platform",
  },
] as const;

const selectedWork = selectedWorkSpecs.flatMap(spec => {
  const project = projects.find(
    ({ id }) => getProjectPath(id) === `/projects/${spec.id}`
  );
  return project ? [{ project, ...spec }] : [];
});
---

<Layout
  title={`${SITE.author} Gao — AI Engineer | ${SITE.title}`}
  description="Bo Gao builds reliable AI agent systems, evaluation workflows, retrieval experiments, and AI developer tools."
>
  <Header />
  <main id="main-content" data-layout="index" class="career-home app-layout">
    <section class="career-hero" aria-labelledby="career-hero-title">
      <div class="hero-avatar career-hero__avatar">
        <img
          src="/images/site/avatar.svg"
          alt="Portrait of Bo"
          width="1254"
          height="1254"
          decoding="async"
          class="hero-avatar__image hero-avatar__image--light h-full w-full rounded-full object-cover"
        />
        <img
          src="/images/site/avatar-dark.svg"
          alt="Portrait of Bo"
          width="1254"
          height="1254"
          decoding="async"
          class="hero-avatar__image hero-avatar__image--dark h-full w-full rounded-full object-cover"
        />
      </div>

      <div class="career-hero__content">
        <h1 id="career-hero-title" class="career-hero__title">
          Bo Gao <span aria-hidden="true">—</span> AI Engineer
        </h1>
        <p class="career-hero__summary">
          I build reliable agent systems, evaluation workflows, retrieval
          experiments, and AI developer tools.
        </p>

        <div
          class="career-hero__profile-links"
          aria-label="Professional profiles"
        >
          <a
            class="career-hero__profile-link hand-underline-trigger"
            href={SITE.profile}
            rel="me noreferrer"
            target="_blank"
            aria-label="Explore my projects, code, and experiments on GitHub"
          >
            <IconGitHub aria-hidden="true" />
            <span>
              <small>Projects, code, and experiments</small>
              <strong class="hand-underline">GitHub</strong>
            </span>
            <IconArrowRight aria-hidden="true" />
          </a>
          <a
            class="career-hero__profile-link hand-underline-trigger"
            href={SITE.linkedin}
            rel="me noreferrer"
            target="_blank"
            aria-label="Connect on LinkedIn. Open to AI engineering roles in the United States."
          >
            <IconLinkedIn aria-hidden="true" />
            <span>
              <small>Open to AI engineering roles in the U.S.</small>
              <strong class="hand-underline">LinkedIn</strong>
            </span>
            <IconArrowRight aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section id="selected-work" class="career-section">
      <div class="career-section__heading">
        <div>
          <p class="notebook-kicker">01 / Selected work</p>
        </div>
        <a class="career-section__link ink-link" href="/projects/">
          View all work <IconArrowRight aria-hidden="true" />
        </a>
      </div>

      <ol class="selected-work-list">
        {
          selectedWork.map(({ project, tags, artifact }, index) => (
            <li class="selected-work-row">
              <a
                class="selected-work-row__link hand-underline-trigger"
                href={getProjectPath(project.id)}
              >
                <span class="selected-work-row__number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="selected-work-row__title hand-underline">
                  {project.data.title}
                </span>
                <span class="selected-work-row__description">
                  {project.data.description}
                </span>
                <span class="selected-work-row__tags" aria-label="Highlights">
                  {tags.map(tag => (
                    <span>{tag}</span>
                  ))}
                </span>
                <span class="selected-work-row__artifact">
                  <IconFileText aria-hidden="true" />
                  {artifact}
                </span>
                <IconArrowRight
                  class="selected-work-row__arrow"
                  aria-hidden="true"
                />
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
  <Footer noMarginTop />
</Layout>

<script>
  type HomeWindow = Window & {
    __homeBackUrlCleanup?: () => void;
    __homeAvatarHoverCleanup?: () => void;
  };

  import { setupHomePage } from "@/scripts/homePage";

  (window as HomeWindow).__homeBackUrlCleanup?.();
  document.addEventListener("astro:page-load", setupHomePage);
  (window as HomeWindow).__homeBackUrlCleanup = () => {
    document.removeEventListener("astro:page-load", setupHomePage);
    (window as HomeWindow).__homeAvatarHoverCleanup?.();
    (window as HomeWindow).__homeAvatarHoverCleanup = undefined;
  };
  setupHomePage();
</script>
