---
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import OpenSourceCard from "@/components/OpenSourceCard.astro";
import PostRow from "@/components/PostRow.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconFileText from "@/assets/icons/IconFileText.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconLinkedInMark from "@/assets/icons/IconLinkedInMark.svg";
import { SITE } from "@/config";
import { HOMEPAGE_PROJECTS, OPEN_SOURCE, PROFILE } from "@/data/profile";
import { getPosts } from "@/utils/posts";
import { getProjects, getProjectSlug } from "@/utils/projects";
import "@/styles/home.css";

const projects = await getProjects();

const homepageProjects = HOMEPAGE_PROJECTS.flatMap(slug => {
  const project = projects.find(({ id }) => getProjectSlug(id) === slug);
  return project ? [project] : [];
});

const recentPosts = (await getPosts()).slice(0, 3);

// A portfolio homepage is a profile of one person.
const structuredData = {
  "@type": "ProfilePage",
  url: Astro.site?.href,
  mainEntity: {
    "@type": "Person",
    name: PROFILE.name,
    jobTitle: PROFILE.role,
    description: PROFILE.summary,
    image: new URL("/images/site/avatar.svg", Astro.url).href,
    url: Astro.site?.href,
    sameAs: [SITE.profile, SITE.linkedin],
  },
};
---

<Layout
  title={`${PROFILE.name} — ${PROFILE.role} | ${SITE.title}`}
  description={`${PROFILE.summary} ${PROFILE.availability}`}
  structuredData={structuredData}
  footerNoMarginTop
>
  <main
    id="main-content"
    data-layout="index"
    data-back-label={SITE.showBackButton ? "Home" : undefined}
    data-back-scope={SITE.showBackButton ? "posts projects" : undefined}
    class="career-home app-layout"
  >
    <section class="career-hero" aria-labelledby="career-hero-title">
      <div class="hero-avatar career-hero__avatar">
        {
          /* The largest thing above the fold: ink only, the theme supplies
             the paper color behind it. */
        }
        <img
          src="/images/site/avatar.svg"
          alt={`Illustrated portrait of ${PROFILE.name}`}
          width="1254"
          height="1254"
          fetchpriority="high"
          class="hero-avatar__image h-full w-full rounded-full object-cover"
        />
      </div>

      <div class="career-hero__content">
        <h1 id="career-hero-title" class="career-hero__title">
          <span class="marker-swipe">{PROFILE.name}</span>
        </h1>
        <p class="career-hero__role">{PROFILE.role}</p>
        <div class="career-hero__summary">
          {PROFILE.intro.map(paragraph => <p>{paragraph}</p>)}
        </div>
        <p class="career-hero__status">
          <span class="career-hero__status-dot" aria-hidden="true"></span>
          {PROFILE.availability}
        </p>

        <div class="career-hero__actions" aria-label="Contact and profiles">
          <a
            class="hero-action hero-action--icon hero-action--github"
            href={SITE.profile}
            rel="me noreferrer"
            target="_blank"
            aria-label="GitHub"
            title="GitHub"
          >
            <IconGitHub aria-hidden="true" />
          </a>
          <a
            class="hero-action hero-action--icon hero-action--linkedin"
            href={SITE.linkedin}
            rel="me noreferrer"
            target="_blank"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <IconLinkedInMark aria-hidden="true" />
          </a>
          {
            SITE.resumeUrl && (
              <a
                class="hero-action hero-action--icon"
                href={SITE.resumeUrl}
                aria-label="Résumé"
                title="Résumé"
              >
                <IconFileText aria-hidden="true" />
              </a>
            )
          }
        </div>
      </div>
    </section>

    <section id="work" class="career-section" aria-labelledby="work-heading">
      <div class="career-section__heading">
        <h2 id="work-heading" class="career-section__title">
          <span class="marker-swipe marker-swipe--blue">Projects</span>
        </h2>
        <a class="more-link ink-link" href="/projects/">
          All projects <IconArrowRight aria-hidden="true" />
        </a>
      </div>

      <div class="work-grid">
        {homepageProjects.map(project => <ProjectCard {...project} />)}
      </div>
    </section>

    <section
      id="open-source"
      class="career-section"
      aria-labelledby="open-source-heading"
    >
      <div class="career-section__heading">
        <h2 id="open-source-heading" class="career-section__title">
          <span class="marker-swipe marker-swipe--green">
            Open Source Contributions
          </span>
        </h2>
      </div>

      <div class="work-grid">
        {OPEN_SOURCE.map(entry => <OpenSourceCard {...entry} />)}
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section
          id="writing"
          class="career-section"
          aria-labelledby="writing-heading"
        >
          <div class="career-section__heading">
            <h2 id="writing-heading" class="career-section__title">
              <span class="marker-swipe marker-swipe--pink">Recent Posts</span>
            </h2>
            <a class="more-link ink-link" href="/posts/">
              All posts <IconArrowRight aria-hidden="true" />
            </a>
          </div>

          <ol class="post-list">
            {recentPosts.map(post => (
              <PostRow post={post} />
            ))}
          </ol>
        </section>
      )
    }
  </main>
</Layout>

<script>
  import { onEveryPage } from "@/scripts/lifecycle";
  import { setupHomePage } from "@/scripts/homePage";

  onEveryPage(setupHomePage);
</script>
