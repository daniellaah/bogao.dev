---
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getYear } from "@/utils/date";
import { SITE } from "@/config";
import type { Post } from "@/utils/posts";
import { slugifyStr } from "@/utils/slugifyCore";
import "@/styles/controls.css";

type Props = {
  posts: Post[];
};

const { posts } = Astro.props;

const years = Array.from(
  new Set(posts.map(post => getYear(post.data.pubDatetime)))
).sort((a, b) => Number(b) - Number(a));

const availableTags = new Map(
  posts.flatMap(post =>
    post.data.tags.map(tag => [slugifyStr(tag), tag] as const)
  )
);

const tags = SITE.postPopularFilterTags.flatMap(configuredTag => {
  const slug = slugifyStr(configuredTag);
  const tagName = availableTags.get(slug);
  return tagName ? [{ slug, tagName }] : [];
});

const filterButtonClass =
  "ink-toggle-button chip inline-flex min-h-11 items-center px-3 py-1 text-sm font-medium text-graphite";
---

{
  posts.length > 0 && (
    <section
      class="content-controls"
      data-post-filters
      aria-label="Filter posts"
    >
      <div class="content-status">
        {/* Filled in by the script only while a filter is active. */}
        <p
          class="content-status__message"
          data-filter-status
          aria-live="polite"
        />
      </div>

      <div class="space-y-2">
        {/* A year filter with one year to pick is just noise. */}
        <div class="toggle-control-row" hidden={years.length < 2}>
          <span class="notebook-kicker">Year</span>
          <div
            class="ink-toggle post-filter-toggle flex flex-wrap gap-2"
            data-filter-toggle="year"
            aria-label="Filter posts by year"
          >
            <button
              type="button"
              data-filter-year="all"
              class={filterButtonClass}
              data-active
              aria-pressed="true"
            >
              All
            </button>
            {years.map(year => (
              <button
                type="button"
                data-filter-year={year}
                class={filterButtonClass}
                aria-pressed="false"
              >
                {year}
              </button>
            ))}
          </div>
        </div>

        {tags.length > 0 && (
          <div class="toggle-control-row">
            <span class="notebook-kicker">Tag</span>
            <div class="flex flex-wrap items-center gap-2">
              <div
                class="ink-toggle post-filter-toggle flex flex-wrap gap-2"
                data-filter-toggle="tag"
                aria-label="Filter posts by tag"
              >
                <button
                  type="button"
                  data-filter-tag="all"
                  class={filterButtonClass}
                  data-active
                  aria-pressed="true"
                >
                  All
                </button>
                {tags.map(tag => (
                  <button
                    type="button"
                    data-filter-tag={tag.slug}
                    class={filterButtonClass}
                    aria-pressed="false"
                  >
                    {tag.tagName}
                  </button>
                ))}
              </div>
              <a href="/tags/" class="more-link ink-link ms-1 min-h-11">
                All tags <IconArrowRight aria-hidden="true" />
              </a>
            </div>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  import { onEveryPage } from "@/scripts/lifecycle";
  import { setupPostFiltersPage } from "@/scripts/postFilters";

  onEveryPage(setupPostFiltersPage);
</script>
