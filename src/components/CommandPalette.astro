---
import IconSearch from "@/assets/icons/IconSearch.svg";
import searchKinds from "@/data/search-kinds.json";
import { formatSearchInputPlaceholder } from "@/utils/search";
import "@/styles/command-palette.css";

const searchInputPlaceholder = formatSearchInputPlaceholder(
  searchKinds[0].scope
);
---

<!--
  A native modal dialog: showModal() traps focus, makes the page inert, closes
  on Escape and returns focus to the opener. The dialog itself is a bare frame
  so that a click landing on it (not on the panel) is a click on the backdrop.
-->
<dialog
  id="command-palette"
  class="command-palette"
  aria-labelledby="command-palette-title"
>
  <div class="command-palette__panel panel card-border">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="notebook-kicker">Command search</p>
        <h2 id="command-palette-title" class="mt-1 text-xl font-semibold">
          Search anything
        </h2>
      </div>
      <button
        type="button"
        class="chip px-2 py-1 font-code text-xs"
        aria-label="Close search"
        data-command-close
      >
        Esc
      </button>
    </div>

    <div class="command-palette__input-wrap">
      <label class="sr-only" for="command-palette-input">Search</label>
      <IconSearch class="command-palette__icon" aria-hidden="true" />
      <input
        id="command-palette-input"
        type="search"
        placeholder={searchInputPlaceholder}
        autocomplete="off"
        aria-busy="false"
        aria-controls="command-palette-results"
        aria-describedby="command-palette-status"
        class="command-palette__input"
      />
      <span
        id="command-palette-thinking"
        class="thinking-dots"
        aria-hidden="true"
      >
        <span></span>
        <span></span>
        <span></span>
      </span>
    </div>

    <div
      id="command-palette-results-panel"
      class="command-palette__results-panel"
      hidden
    >
      <p
        id="command-palette-status"
        class="font-code text-xs text-graphite"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
      </p>
      <ul
        id="command-palette-results"
        class="command-palette__results-list"
        role="list"
      >
      </ul>
    </div>
  </div>
</dialog>

<script>
  import { onEveryPage } from "@/scripts/lifecycle";
  import { setupCommandPalettePage } from "@/scripts/commandPalette";

  onEveryPage(setupCommandPalettePage);
</script>
