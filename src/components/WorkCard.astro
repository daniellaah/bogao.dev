---
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import type { Accent } from "@/utils/projects";
import "@/styles/work-card.css";

type Props = {
  href: string;
  kicker?: string;
  title: string;
  description: string;
  tags: readonly string[];
  external?: boolean;
  preview?: { label: string; meta: string; title: string };
  accent?: Accent;
  // The headline card: spans the grid, with its results beside the text.
  featured?: boolean;
  metrics?: readonly { value: string; label: string }[];
};

const {
  href,
  kicker,
  title,
  description,
  tags,
  external = false,
  preview,
  accent = "yellow",
  featured = false,
  metrics = [],
} = Astro.props;
---

<a
  class:list={[
    `work-card work-card--${accent} card-border hover-underline-trigger`,
    { "work-card--featured": featured },
  ]}
  href={href}
  rel={external ? "noreferrer" : undefined}
  target={external ? "_blank" : undefined}
>
  {kicker && <span class="work-card__kicker">{kicker}</span>}
  <span class="work-card__title hover-underline">{title}</span>
  <span class="work-card__description">{description}</span>
  {
    preview && (
      <span class="work-card__preview">
        <span class="work-card__preview-head">
          <span>{preview.label}</span>
          <span>{preview.meta}</span>
        </span>
        <span class="work-card__preview-title">{preview.title}</span>
      </span>
    )
  }
  {
    featured && metrics.length > 0 && (
      <span class="work-card__metrics">
        {metrics.map(({ value, label }) => (
          <span class="work-card__metric">
            <span class="work-card__metric-value">{value}</span>
            <span class="work-card__metric-label">{label}</span>
          </span>
        ))}
      </span>
    )
  }
  <span class="work-card__footer">
    <span class="work-card__tags">
      {tags.map(tag => <span>{tag}</span>)}
    </span>
    <IconArrowRight class="work-card__arrow" aria-hidden="true" />
  </span>
</a>
