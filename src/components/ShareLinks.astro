---
import IconBrandX from "@/assets/icons/IconBrandX.svg";
import IconLink from "@/assets/icons/IconLink.svg";
import IconLinkedIn from "@/assets/icons/IconLinkedIn.svg";
import IconMail from "@/assets/icons/IconMail.svg";

type Props = {
  title: string;
};

const { title } = Astro.props;
const url = Astro.url.href;
const shareUrl = encodeURIComponent(url);
const shareTitle = encodeURIComponent(title);

// Where readers of an engineering post actually share it. "Copy link" is
// rendered separately because it needs a script, not a URL.
const shareLinks = [
  {
    label: "LinkedIn",
    linkTitle: "Share this post on LinkedIn",
    icon: IconLinkedIn,
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`,
  },
  {
    label: "X",
    linkTitle: "Share this post on X",
    icon: IconBrandX,
    href: `https://x.com/intent/post?url=${shareUrl}&text=${shareTitle}`,
  },
  {
    label: "Email",
    linkTitle: "Share this post via email",
    icon: IconMail,
    href: `mailto:?subject=${shareTitle}&body=${shareUrl}`,
  },
];
---

<div class="share-links">
  <span class="notebook-kicker">Share this post</span>
  <div class="share-links__list">
    {
      shareLinks.map(social => (
        <a
          class="share-link chip"
          href={social.href}
          title={social.linkTitle}
          rel="noreferrer"
          target="_blank"
        >
          <social.icon aria-hidden="true" />
          {social.label}
        </a>
      ))
    }
    <button
      type="button"
      class="share-link chip"
      data-copy-link={url}
      title="Copy the link to this post"
    >
      <IconLink aria-hidden="true" />
      <span data-copy-link-label>Copy link</span>
    </button>
  </div>
</div>

<script>
  import { copyText } from "@/scripts/clipboard";

  const COPY_LABEL = "Copy link";
  let resetTimer: number | undefined;

  // Delegated, so it keeps working for buttons swapped in by navigation.
  document.addEventListener("click", async event => {
    const button = (event.target as Element | null)?.closest<HTMLElement>(
      "[data-copy-link]"
    );
    if (!button) return;

    const label = button.querySelector("[data-copy-link-label]");
    const copied = await copyText(button.dataset.copyLink ?? "");
    if (!label) return;

    label.textContent = copied ? "Copied" : "Copy failed";
    window.clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      label.textContent = COPY_LABEL;
    }, 1800);
  });
</script>
