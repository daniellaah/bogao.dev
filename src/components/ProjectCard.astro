---
import WorkCard from "./WorkCard.astro";
import { getProjectPath, type Project } from "@/utils/projects";

type Props = Project;

const { id, data, accent } = Astro.props;
---

<WorkCard
  href={getProjectPath(id)}
  kicker={data.kicker}
  title={data.title}
  description={data.description}
  tags={data.tags}
  accent={accent}
  featured={data.featured}
  metrics={data.metrics}
/>
