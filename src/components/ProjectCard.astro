---
import type { CollectionEntry } from "astro:content";
import WorkCard from "./WorkCard.astro";
import type { Accent } from "@/utils/accent";
import { getProjectPath } from "@/utils/getProjectPath";

type Props = CollectionEntry<"projects"> & { accent: Accent };

const { id, data, accent } = Astro.props;
---

<WorkCard
  href={getProjectPath(id)}
  kicker={data.kicker}
  title={data.title}
  description={data.description}
  tags={data.tags}
  accent={accent}
/>
