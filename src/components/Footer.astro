---
import type { HTMLAttributes } from "astro/types";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconLinkedIn from "@/assets/icons/IconLinkedIn.svg";
import { SITE } from "@/config";
import "@/styles/footer.css";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="site-footer">
    <p class="site-footer__lead">Let's build something.</p>

    <div class="site-footer__links">
      <a
        class="ink-link"
        href={SITE.profile}
        rel="me noreferrer"
        target="_blank"
      >
        <IconGitHub aria-hidden="true" />
        GitHub
      </a>
      <a
        class="ink-link"
        href={SITE.linkedin}
        rel="me noreferrer"
        target="_blank"
      >
        <IconLinkedIn aria-hidden="true" />
        LinkedIn
      </a>
    </div>

    <p>© {currentYear} {SITE.title}</p>
  </div>
</footer>
